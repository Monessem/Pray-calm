{
  "name": "tcalm-firefox",
  "version": "1.1.26",
  "description": "Tcalm for Firefox — Islamic prayer times, notifications, and media pause in Firefox tabs. Offline, private, bilingual (English / العربية).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abod8639/Tcalm"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.ts",
    "lint": "tsc --noEmit && eslint . && node scripts/audit.mjs && node scripts/deadcode.mjs",
    "audit": "node scripts/audit.mjs",
    "package": "node scripts/package.mjs",
    "assets": "python3 scripts/make-icons.py && python3 scripts/make-chime.py",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.0",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
